@page "/"

@using smk_practical_project.Data
@using smk_practical_project.Models
@inject TodoRepo TodoRepo
@rendermode InteractiveServer

<PageTitle>Todo</PageTitle>

    <p>TO-DOS</p>
    <h1>Tasks</h1>
    <p><b>@todos.Count(todo => !todo.IsCompleted)</b> remaining <b>@todos.Count(todo => todo.IsActive)</b> active <b>@todos.Count(todo => todo.IsCompleted)</b> done</p>

<div class="list">
    <ul>
        <li>
            <input @bind="newTodoTitle" placeholder="Add a new task"/>
            <button @onclick="AddTodo">+</button>
        </li>
        <li class = "priority">
            <label for="lowprio" style="color:rgb(140, 221, 176)">&#9679 Low</label>
            <input type="radio" id="lowprio" name="priority" @onchange="@(() => taskPriority =1)" />
            <label for="misprio" style="color:rgb(193, 148, 207)"">&#9679 Medium </label>
            <input type="radio" id="midprio" name="priority" @onchange="@(() => taskPriority =2)" />
            <label for="highprio" style="color:rgb(207, 112, 112)">&#9679 High</label>
            <input type="radio" id="highprio" name="priority" @onchange="@(() => taskPriority =3)" />
        </li>
    </ul>
</div>

<button @onclick="ClearCompleted">Clear done</button>

<div class="list">
    <ul>
        @foreach (var todo in todos)
        {
            <li>
                <span class="container-check">
                    <input type="checkbox" class="todo-check" checked="@todo.IsCompleted" @onchange="() => ToggleComplete(todo)" />
                        <span class="check">✓</span>
                </span>
                <span class="container-act">
                    <input type="checkbox" class="todo-act" checked="@todo.IsActive" @onchange="() => ToggleActive(todo)" />
                    @if(todo.IsActive){
                        <span class="pause">❚❚</span>
                    }
                    else{
                        <span class="resume">▶</span>
                    }
                </span>
                @if (todoToEdit == todo.Id)
                {
                    <input @bind="editTitle" />
                    <button @onclick="() =>SaveEdit(todo)">Save</button>
                    <button @onclick="CancelEdit">Cancel</button>

                }
                else {
                    @if (todo.IsCompleted && todo.IsActive)
                    {
                        <s>@todo.Title</s>
                    }
                    else if(!todo.IsActive && !todo.IsCompleted)
                    {
                        <span style="color: rgb(116, 114, 114);">@todo.Title</span>
                    }
                    else if(todo.IsCompleted)
                    {
                        <s style="color: rgb(116, 114, 114);">@todo.Title</s>
                    }
                    else
                    {
                        @todo.Title
                    }
                    @if (todo.Priority == 1){
                        <span class="prio" style="color:rgb(140, 221, 176)">&#9679</span>
                    }
                    else if (todo.Priority == 2){
                        <span class="prio" style="color:rgb(193, 148, 207)">&#9679</span>
                    }
                    else {
                        <span class="prio" style="color:rgb(207, 112, 112)">&#9679</span>
                    }

                    <button class="todo-edit" @onclick="() => EditTask(todo)">&#9998</button>
                }
            </li>
        }
    </ul>
</div>

@code {
    private List<TodoItem> todos = [];
    private string newTodoTitle = string.Empty;
    private int taskPriority = 0;
    private int? todoToEdit = null;
    private string? editTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        todos = (await TodoRepo.GetAllAsync()).ToList();
    }

    private async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(newTodoTitle))
            return;

        await TodoRepo.CreateAsync(newTodoTitle, taskPriority);
    
        newTodoTitle = string.Empty;
        taskPriority = 0;

        await LoadTodos();
    }

    private async Task ToggleComplete(TodoItem todo){
        todo.IsCompleted = !todo.IsCompleted;
        
        if (todo.IsCompleted){
            todo.IsActive = false;
        }


        await TodoRepo.UpdateAsync(todo);

        await LoadTodos();
    }

    private async Task ToggleActive(TodoItem todo){
        todo.IsActive = !todo.IsActive;

        await TodoRepo.UpdateAsync(todo);

        await LoadTodos();
    }

    private async Task ClearCompleted(){
        var completedTodos = todos.Where(todo => todo.IsCompleted);

        foreach (var todo in completedTodos)
        {
            await TodoRepo.DeleteAsync(todo.Id);
        }

        await LoadTodos();
    }

    private async Task EditTask(TodoItem todo){
            todoToEdit = todo.Id;
            editTitle = todo.Title;
    }
    private async Task CancelEdit(){
        todoToEdit = null;
        editTitle = string.Empty;
    }
    private async Task SaveEdit(TodoItem todo){
        if (string.IsNullOrWhiteSpace(editTitle))
            return;

        todo.Title = editTitle; 

        await TodoRepo.UpdateAsync(todo);
        await LoadTodos();

        todoToEdit = null;
        editTitle = string.Empty;
    }
}
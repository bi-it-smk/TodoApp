@page "/"

@using smk_practical_project.Data
@using smk_practical_project.Models
@inject TodoRepo TodoRepo
@rendermode InteractiveServer

<PageTitle>Todo</PageTitle>

    <p>TO-DOS</p>
    <h1>Tasks</h1>
    <p><b>@todos.Count(todo => !todo.IsCompleted)</b> remaining <b>@todos.Count(todo => todo.IsActive)</b> active <b>@todos.Count(todo => todo.IsCompleted)</b> done</p>

<div class="list">
    <ul>
        <li>
            <input @bind="newTodoTitle" placeholder="Add a new task"/>
            <button @onclick="AddTodo">+</button>
        </li>
        <li>
            <input @bind ="newTodoDescription" placeholder="Add description"/>
        </li>
        <li class = "priority">
            <label for="lowprio" style="color:rgb(140, 221, 176)">&#9679 Low</label>
            <input type="radio" id="lowprio" name="priority" checked="@(taskPriority==1)" @onchange="@(() => taskPriority =1)" />
            <label for="midprio" style="color:rgb(193, 148, 207)"">&#9679 Medium </label>
            <input type="radio" id="midprio" name="priority" checked="@(taskPriority==2)" @onchange="@(() => taskPriority =2)" />
            <label for="highprio" style="color:rgb(207, 112, 112)">&#9679 High</label>
            <input type="radio" id="highprio" name="priority" checked="@(taskPriority==3)" @onchange="@(() => taskPriority =3)" />
        </li>
    </ul>
</div>
<div class="filterSort">
    <label for="filter">filter:</label>
    <select id="filter" @bind="FilterStatus">
        <option value="All">all</option>
        <option value="Open">open</option>
        <option value="Closed">closed</option>
        <option value="Active">active</option>
        <option value="Paused">paused</option>
    </select>
    <label for="sort">sort by:</label>
    <select id="sort" @bind ="SortStatus">
        <option value="old">oldest</option>
        <option value="new">newest</option>
        <option value="highlow">priority high-low</option>
        <option value="lowhigh">priority low-high</option>
    </select>
</div>
<div class="list">
    <ul>
        @foreach (var todo in SortedTodos)
        {
            <li>
                <span class="container-check">
                    <input type="checkbox" class="todo-check" checked="@todo.IsCompleted" @onchange="() => ToggleComplete(todo)" />
                        <span class="check">✓</span>
                </span>
                <span class="container-act">
                    <input type="checkbox" class="todo-act" checked="@todo.IsActive" @onchange="() => ToggleActive(todo)" />
                    @if(todo.IsActive){
                        <span class="pause">❚❚</span>
                    }
                    else{
                        <span class="resume">▶</span>
                    }
                </span>
                @if (todoToEdit == todo.Id)
                {
                    <input @bind="editTitle" />
                    <select id="filter" @bind="editPriority">
                        <option value="1">low priority</option>
                        <option value="2">medium priority</option>
                        <option value="3">high priority</option>
                    </select>
                    <button @onclick="() =>SaveEdit(todo)">Save</button>
                    <button @onclick="CancelEdit">Cancel</button>
                    <button @onclick="() =>DeleteTask(todo)">Delete</button>
                }
                else {
                    @if (todo.IsCompleted && todo.IsActive)
                    {
                        <s>@todo.Title</s>
                    }
                    else if(!todo.IsActive && !todo.IsCompleted)
                    {
                        <span style="color: rgb(116, 114, 114);">@todo.Title</span>
                    }
                    else if(todo.IsCompleted)
                    {
                        <s style="color: rgb(116, 114, 114);">@todo.Title</s>
                    }
                    else
                    {
                        @todo.Title
                    }
                    @if (todo.Priority == 1){
                        <span class="prio" style="color:rgb(140, 221, 176)">&#9679</span>
                    }
                    else if (todo.Priority == 2){
                        <span class="prio" style="color:rgb(193, 148, 207)">&#9679</span>
                    }
                    else {
                        <span class="prio" style="color:rgb(207, 112, 112)">&#9679</span>
                    }
                    <button class="todo-edit" @onclick="() => EditTask(todo)">&#9998</button>
                    <p>@todo.Description</p>
                }
            </li>
        }
    </ul>
</div>
<button @onclick="ClearCompleted">Clear done</button>

@code {
    private List<TodoItem> todos = [];
    private string newTodoTitle = string.Empty;
    private int taskPriority = 2;
    private int? todoToEdit = null;
    private string? editTitle = string.Empty;

    private int editPriority = 0;

    private string FilterStatus = "All";

    private string SortStatus = "new";

    private string newTodoDescription = string.Empty;

    protected override async Task OnInitializedAsync() // Gets called upon start of app
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        todos = (await TodoRepo.GetAllAsync()).ToList();
    }

    private IEnumerable<TodoItem> FilteredTodos =>
        FilterStatus switch{
            "Open" => todos.Where(todo => !todo.IsCompleted),
            "Closed" => todos.Where(todo => todo.IsCompleted),
            "Active" => todos.Where(todo => todo.IsActive),
            "Paused" => todos.Where(todo => !todo.IsActive && !todo.IsCompleted),
            _ => todos
        };

    private IEnumerable<TodoItem> SortedTodos =>
        SortStatus switch{
            "new" => FilteredTodos.OrderByDescending(todo => todo.Id),
            "highlow" => FilteredTodos.OrderByDescending(todo => todo.Priority),
            "lowhigh" => FilteredTodos.OrderBy(todo => todo.Priority),
            _ => FilteredTodos
        };

    private async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(newTodoTitle))
            return;

        await TodoRepo.CreateAsync(newTodoTitle, taskPriority, newTodoDescription);
    
        newTodoTitle = string.Empty;
        newTodoDescription = string.Empty;

        await LoadTodos();
    }

    private async Task ToggleComplete(TodoItem todo){
        todo.IsCompleted = !todo.IsCompleted;
        
        if (todo.IsCompleted){
            todo.IsActive = false;
        }


        await TodoRepo.UpdateAsync(todo);

        await LoadTodos();
    }

    private async Task ToggleActive(TodoItem todo){
        todo.IsActive = !todo.IsActive;

        await TodoRepo.UpdateAsync(todo);

        await LoadTodos();
    }

    private async Task ClearCompleted(){
        var completedTodos = todos.Where(todo => todo.IsCompleted);

        foreach (var todo in completedTodos)
        {
            await TodoRepo.DeleteAsync(todo.Id);
        }

        await LoadTodos();
    }

    private async Task EditTask(TodoItem todo){
            todoToEdit = todo.Id;
            editTitle = todo.Title;
            editPriority = todo.Priority;
    }
    private async Task CancelEdit(){
        todoToEdit = null;
        editTitle = string.Empty;
    }
    private async Task SaveEdit(TodoItem todo){
        if (string.IsNullOrWhiteSpace(editTitle))
            return;

        todo.Title = editTitle; 
        todo.Priority = editPriority;

        await TodoRepo.UpdateAsync(todo);
        await LoadTodos();

        todoToEdit = null;
        editTitle = string.Empty;
        editPriority = 0;
    }

    private async Task DeleteTask(TodoItem todo){
        await TodoRepo.DeleteAsync(todo.Id);
        await LoadTodos();

        todoToEdit = null;
        editTitle = string.Empty;
        editPriority = 0;
    }
}